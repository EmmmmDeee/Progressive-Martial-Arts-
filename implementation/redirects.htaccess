# Generated from graph/migration-map.tsv — do not hand-edit.
# Deterministic single-hop migrations: no chains, no loops.
# Apply in the site root .htaccess ABOVE the WordPress rewrite block.
<IfModule mod_rewrite.c>
RewriteEngine On
# Protocol canonicalisation first (audit P1 / work-order P0-4):
RewriteCond %{HTTPS} !=on
